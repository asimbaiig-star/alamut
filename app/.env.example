# Copy to `.env.local` (gitignored) and fill in real values.
# Both vars are exposed to the client by Vite — the anon / publishable
# key is safe to expose; the service role key is NOT and must never
# appear in client code.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# Optional — where to POST captured errors (unhandled exceptions, promise
# rejections, React render crashes). Any JSON collector works: a Supabase
# Edge Function, a Slack incoming webhook, etc. Leave unset and errors are
# still captured locally and readable via `window.__alamutErrors` in the
# browser console. See src/lib/utils/errorReporting.ts.
# VITE_ERROR_WEBHOOK=https://hooks.example.com/alamut-errors
