# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
**/dist/
**/build/
.vite/
**/.vite/

# Vercel
.vercel/

# Environment / secrets
.env
.env.local
.env.*.local
*.local

# Claude config — keep lightweight per-project files (launch.json) but
# exclude personal settings and locally-installed skill bundles.
**/.claude/settings.local.json
**/.claude/skills/
/.claude/launch.json

# Agent skill bundles installed locally via `npx skills add ...`.
# These are symlinks to per-developer tool installations; not portable.
**/.agents/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# Vitest cache
.vitest-cache/

# Local backup folders (point-in-time snapshots — git history covers this)
_backup-*/

# Supabase CLI working state — auto-generated per-link / per-machine.
# Contains project ref + cached version pins, no secrets, but it's noise
# and changes whenever someone re-links from a different machine.
**/supabase/.temp/
**/supabase/.branches/
